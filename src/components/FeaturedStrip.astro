---
/**
 * FeaturedStrip — the home-page featured strip (SPEC §4, §6.1: 3–5 entries
 * flagged `featured`, newest first). Each item selects its vertex in the
 * porism diagram (via `ach:select`) — the strip is a table of contents for
 * the figure, not a second trophy case.
 */
import LogoChip from './LogoChip.astro';
import { yearOf, type Achievement } from '../lib/achievements';

interface Props {
  entries: Achievement[]; // featured only, newest first
}

const { entries } = Astro.props;
---

<section class="featured" aria-labelledby="featured-heading">
  <h2 id="featured-heading">Featured</h2>
  <ul class="featured-strip">
    {
      entries.map((e) => (
        <li>
          <button type="button" class="featured-item" data-select={e.id}>
            <LogoChip logo={e.logo} shortName={e.shortName} />
            <span class="f-body">
              <span class="f-kicker">
                {yearOf(e)} · {e.shortName}
              </span>
              <span class="f-award">{e.award}</span>
              {e.rank && <span class="f-rank">{e.rank}</span>}
            </span>
          </button>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .featured {
    margin-top: 3.5rem;
  }

  .featured-strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hairline);
  }

  .featured-strip li + li {
    border-left: 1px solid var(--hairline);
  }

  .featured-item {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    width: 100%;
    height: 100%;
    padding: 1.25rem 1.5rem;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .f-body {
    display: grid;
    gap: 0.1rem;
  }

  .f-kicker {
    font-size: var(--text--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--slate);
  }

  .f-award {
    font-family: var(--font-display);
    font-size: var(--text-1);
    line-height: 1.25;
    transition: color 150ms ease;
  }

  .f-rank {
    font-size: var(--text--1);
    color: var(--slate);
  }

  .featured-item:hover .f-award,
  .featured-item:focus-visible .f-award {
    color: var(--accent);
  }

  @media (max-width: 639px) {
    .featured-strip {
      grid-template-columns: minmax(0, 1fr);
    }

    .featured-strip li + li {
      border-left: 0;
      border-top: 1px solid var(--hairline);
    }

    .featured-item {
      padding: 1rem 0.25rem;
    }
  }
</style>

<script>
  // Ask the porism island (and the view toggle) to open this achievement.
  document.querySelectorAll<HTMLButtonElement>('.featured-item').forEach((btn) => {
    btn.addEventListener('click', () => {
      window.dispatchEvent(
        new CustomEvent('ach:select', { detail: { id: btn.dataset.select } }),
      );
      const figure = document.querySelector('figure.poncelet');
      if (figure) {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        // Let a hidden Porism view re-appear before scrolling to it.
        requestAnimationFrame(() =>
          figure.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'center' }),
        );
      }
    });
  });
</script>
