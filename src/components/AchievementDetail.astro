---
/**
 * AchievementDetail — the detail panel beside the diagram (SPEC §5.4).
 *
 * Every entry gets a server-rendered <article>; exactly one is visible (the
 * latest by default — IMC 2026 on load, §5.4). The Poncelet island swaps
 * panels on `poncelet:select` (see AchievementsView), so selection works
 * with zero per-click rendering. No-JS readers get the default panel plus
 * the plain list (§5.6).
 */
import LogoChip from './LogoChip.astro';
import { formatMonth, yearOf, type Achievement } from '../lib/achievements';

interface Props {
  entries: Achievement[]; // chronological ascending
}

const { entries } = Astro.props;
const defaultId = entries[entries.length - 1].id; // latest = default (§5.4)
---

<aside class="detail" aria-label="Achievement details">
  {
    entries.map((e) => (
      <article class="detail-panel" data-panel={e.id} hidden={e.id !== defaultId}>
        <header class="detail-head">
          <LogoChip logo={e.logo} shortName={e.shortName} />
          <div>
            <p class="detail-kicker">
              {yearOf(e)} · {e.shortName}
            </p>
            <h3 class="detail-title">{e.title}</h3>
          </div>
        </header>

        <p class="detail-award">{e.award}</p>
        {e.competition && <p class="detail-comp">{e.competition}</p>}

        <dl class="detail-facts">
          <div>
            <dt>Date</dt>
            <dd>{formatMonth(e.date)}</dd>
          </div>
          {e.score && (
            <div>
              <dt>Score</dt>
              <dd>{e.score}</dd>
            </div>
          )}
          {e.rank && (
            <div>
              <dt>Rank</dt>
              <dd>{e.rank}</dd>
            </div>
          )}
          {e.location && (
            <div>
              <dt>Location</dt>
              <dd>{e.location}</dd>
            </div>
          )}
          {e.team && (
            <div>
              <dt>Team</dt>
              <dd>{e.team}</dd>
            </div>
          )}
        </dl>

        <p class="detail-desc">{e.description}</p>

        {e.images.length > 0 && (
          <ul class="detail-images">
            {e.images.map((src, i) => (
              <li>
                <a href={`/${src}`}>
                  <img
                    src={`/${src}`}
                    alt={`${e.title} — photo ${i + 1}`}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </li>
            ))}
          </ul>
        )}

        {e.links.length > 0 && (
          <ul class="detail-links">
            {e.links.map((l) => (
              <li>
                <a href={l.url}>{l.label}</a>
              </li>
            ))}
          </ul>
        )}
      </article>
    ))
  }
</aside>

<style>
  .detail-panel {
    border-top: 2px solid var(--ink);
    padding-top: 1rem;
  }

  .detail-head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1rem;
  }

  .detail-kicker {
    margin: 0;
    font-size: var(--text--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--slate);
  }

  .detail-title {
    margin: 0.1rem 0 0;
    font-size: var(--text-1);
  }

  /* Gold where it means something: the award line (§3.1). */
  .detail-award {
    margin: 0 0 0.15rem;
    font-family: var(--font-display);
    font-size: var(--text-1);
    color: var(--accent);
  }

  .detail-comp {
    margin: 0 0 1rem;
    font-size: var(--text--1);
    color: var(--slate);
  }

  .detail-facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem 1.25rem;
    margin: 0 0 1rem;
    padding-block: 0.75rem;
    border-block: 1px solid var(--hairline);
  }

  .detail-facts dt {
    font-size: var(--text--1);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--slate);
  }

  .detail-facts dd {
    margin: 0;
    font-size: var(--text--1);
  }

  .detail-desc {
    margin: 0 0 1rem;
    font-size: var(--text--1);
    line-height: 1.55;
  }

  .detail-images {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .detail-images img {
    display: block;
    width: 5.5rem;
    height: 4rem;
    object-fit: cover;
    border: 1px solid var(--hairline);
    border-radius: 3px;
  }

  .detail-links {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text--1);
  }

  .detail-links li + li {
    margin-top: 0.25rem;
  }
</style>
