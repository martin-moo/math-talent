---
import Base from '../layouts/Base.astro';
import AchievementsView from '../components/AchievementsView.astro';
import FeaturedStrip from '../components/FeaturedStrip.astro';
import { getAchievements, featuredOf } from '../lib/achievements';
import { profile } from '../lib/profile';

// Stage 4: real data from the content collection (SPEC §6.1). Chronological
// ascending; the renderer reads from the end — latest at the top vertex (§5.1).
const entries = await getAchievements();
const featured = featuredOf(entries);
---

<Base title="Akram Zakine — Mathematics" description={profile.tagline}>
  {/* Apply the persisted Porism/Timeline preference before first paint so
      the wrong view never flashes (SPEC §5.5). Unpersisted default: Porism;
      on phones the Timeline leads. */}
  <script is:inline slot="head">
    (function () {
      var view = 'porism';
      try {
        var stored = localStorage.getItem('az:view');
        if (stored === 'porism' || stored === 'timeline') view = stored;
        else if (matchMedia('(max-width: 639px)').matches) view = 'timeline';
      } catch (e) {}
      document.documentElement.dataset.achView = view;
    })();
  </script>

  {/* Netlify Identity on the homepage: the invite/recovery email links land
      here by default (SPEC §8). The widget is passive until it sees a token
      in the URL; it processes it and shows the set-password modal. After
      login we carry the editor straight to /admin.
      Loaded only when a token is actually present (SPEC §5.7): this site has
      no anchor links, so any non-empty hash is the identity flow. On an
      ordinary visit the widget never loads — no third-party script on the
      critical path. On /admin it loads unconditionally. */}
  <script is:inline slot="head">
    (function () {
      var hash = window.location.hash;
      if (!hash) return;
      var s = document.createElement('script');
      s.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
      s.async = true;
      s.onload = function () {
        window.netlifyIdentity.on('init', function (user) {
          if (!user) {
            window.netlifyIdentity.on('login', function () {
              document.location.href = '/admin/';
            });
          }
        });
      };
      document.head.appendChild(s);
    })();
  </script>

  <h1>{profile.name}</h1>
  <p class="tagline">{profile.tagline}</p>

  <div class="wide">
    <AchievementsView entries={entries} bio={{ name: profile.name, text: profile.bioShort }} />
  </div>

  <FeaturedStrip entries={featured} />
</Base>

<style>
  .tagline {
    margin: 0;
    color: var(--slate);
    font-size: var(--text-1);
    line-height: 1.4;
  }
</style>
